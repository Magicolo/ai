# Base pinned by digest: linux/amd64 manifest of
# nvidia/cuda:13.0.0-cudnn-devel-ubuntu24.04 (torch 2.14.0+cu130 needs
# CUDA 13 at runtime; the 12.8 base of voyage-video cannot host it).
# Resolved the same way as the video image (`docker buildx imagetools
# inspect --raw ...`). The tag alone drifts; the digest freezes it.
# Bump procedure: resolve the new amd64 digest the same way, update FROM,
# re-freeze worker/requirements-ltx.txt on a GPU box, note in
# docs/INSTALL.md.
FROM nvidia/cuda:13.0.0-cudnn-devel-ubuntu24.04@sha256:e3fd439288969c0c78d52768cda4a10ab20f408180d6fa2933f94f7af7810cb0

# LTX worker env (DESIGN §140): CUDA 13 + Python 3.11 + torch 2.14.0/cu130
# + pinned ComfyUI stack running IN-PROCESS (PromptExecutor behind a
# fake-server shim — no ComfyUI server process). Separate image from
# voyage-video on purpose: the validated experiment stack (torch 2.14 /
# transformers 5.17) would break voyage-video's frozen torch-2.8 /
# transformers-4.57.6 pins, and the user constraint is to not break
# existing functionality. Layer order keeps slow builds cached across
# voyage-code edits (torch + requirements + clones before COPY).
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    CUDA_HOME=/usr/local/cuda

# Apt rows are intentionally unpinned (noble versions were not pre-resolved;
# the digest-pinned FROM above keeps the snapshot reproducible). Re-query
# procedure: rebuild, run `dpkg-query -W <pkgs>` in the image, pin exact
# with `=`, note in docs/INSTALL.md. python3.11 comes from the deadsnakes
# PPA (noble ships only 3.12; same deadsnake provenance as the TE-2 host
# toolchain fix). python3.11-dev is here (not late) because triton
# JIT-compiles its CUDA utils on first Gemma RoPE use and gcc + Python.h
# must both be present (TE-2 lesson). curl is the get-pip.py fallback if
# deadsnakes ever drops ensurepip from python3.11-venv.
RUN apt-get update \
    && apt-get install -y --no-install-recommends software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3.11-dev \
        git gcc g++ ffmpeg curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python3.11 -m ensurepip --upgrade \
    && ln -sfn /usr/bin/python3.11 /usr/bin/python3

# pip + torch trio from the cu130 index (torch 2.14.0+cu130 is NOT on the
# default index; the cp311 x86_64 wheel was confirmed present pre-build).
# Explicit `python3.11 -m pip`: no python3-pip is installed (that would be
# noble's 3.12 pip — wrong interpreter), so no bare `pip` binary exists.
RUN python3.11 -m pip install "pip==25.0.1" \
    && python3.11 -m pip install torch==2.14.0 torchvision==0.29.0 torchaudio==2.11.0 \
        --index-url https://download.pytorch.org/whl/cu130

# Validated experiment freeze (worker/requirements-ltx.txt header): everything
# except the torch trio above. (textual launcher TUI removed with the
# two-verb CLI — bare `voyage` prints help; no TUI dep here, same as the
# video image which installs only rich for console progress.)
COPY worker/requirements-ltx.txt /tmp/requirements-ltx.txt
RUN python3.11 -m pip install -r /tmp/requirements-ltx.txt

# Verified-fetch clones (same contract as the video image): `--depth 1`
# keeps context small; `fetch <sha>` + `checkout <sha>` + `rev-parse
# --verify` prove the pinned commit is exactly what got checked out.
# Layout mirrors the validated experiment tree (ComfyUI + custom_nodes/
# ComfyUI-GGUF) so Phase-2 workers can reuse the experiment import paths.
# License surface: LTX-2.5/LTX-2.3 GGUF weights pulled at runtime carry
# their upstream licenses (see voyage/registry_ltx25.py + registry_ltx23.py
# + docs/MODELS.md) — check before redistributing images.
RUN git clone --depth 1 https://github.com/comfyanonymous/ComfyUI.git /opt/comfyui \
    && git -C /opt/comfyui fetch --depth 1 origin 2f35f4a08176d993cded35dac3332be4f7287f41 \
    && git -C /opt/comfyui checkout 2f35f4a08176d993cded35dac3332be4f7287f41 \
    && git -C /opt/comfyui rev-parse --verify HEAD \
    && git clone --depth 1 https://github.com/city96/ComfyUI-GGUF.git /opt/comfyui/custom_nodes/ComfyUI-GGUF \
    && git -C /opt/comfyui/custom_nodes/ComfyUI-GGUF fetch --depth 1 origin 6ea2651e7df66d7585f6ffee804b20e92fb38b8a \
    && git -C /opt/comfyui/custom_nodes/ComfyUI-GGUF checkout 6ea2651e7df66d7585f6ffee804b20e92fb38b8a \
    && git -C /opt/comfyui/custom_nodes/ComfyUI-GGUF rev-parse --verify HEAD

# Gemma4 LTX text-encoder patch (validated in the experiment tree): adds
# gemma4 to TXT_ARCH_LIST + LTXV_BF16_PARAMETERS to the GGUF loader.
# Applied with --forward so a rebuild against an already-patched tree fails
# loud instead of double-applying; the grep asserts the marker landed.
COPY worker/patches-ltx25-gemma4.patch /tmp/patches-ltx25-gemma4.patch
RUN patch --forward -p1 -d /opt/comfyui/custom_nodes/ComfyUI-GGUF < /tmp/patches-ltx25-gemma4.patch \
    && grep -q '"gemma4"' /opt/comfyui/custom_nodes/ComfyUI-GGUF/loader.py \
    && grep -q 'LTXV_BF16_PARAMETERS' /opt/comfyui/custom_nodes/ComfyUI-GGUF/loader.py

# Console progress (rich, in requirements) + voyage supervisor package
# (pure-python here; torch lives only behind the worker module import).
# --no-deps: pydantic already pinned above, so the editable install adds
# only the voyage package itself.
COPY pyproject.toml README.md /app/
COPY voyage/ /app/voyage/
RUN python3.11 -m pip install --no-deps -e /app

# Director decider venv (same reason as the video image): the decider needs
# GPTQModel + sentence-transformers, kept isolated so the validated LTX
# freeze above is never perturbed. Pins mirror the video image's director
# venv, on python3.11 (torch 2.11.0+cu128 ships a cp311 wheel). The
# supervisor spawns the director with this interpreter via
# VOYAGE_DIRECTOR_PYTHON below; unset (slim image, tests) falls back to
# sys.executable. voyage itself resolves via the /app PYTHONPATH entry.
RUN python3.11 -m venv /opt/venvs/director \
    && /opt/venvs/director/bin/pip install "pip==25.0.1" \
    && /opt/venvs/director/bin/pip install torch==2.11.0 \
        --index-url https://download.pytorch.org/whl/cu128 \
    && /opt/venvs/director/bin/pip install "GPTQModel==7.5.0" "sentence-transformers==6.1.0" \
        "safetensors==0.8.0" "huggingface_hub[cli]==1.33.0" "pydantic==2.10.6" \
    && /opt/venvs/director/bin/pip install transformers==5.17.0

# LTX prefix-freeze pack (staged by scripts/build-ltx.sh from the Comfy
# checkout, which sits outside this Voyage build context and cannot be
# COPYd directly). Re-attaches the frozen-prefix noise_mask that
# LTXVLatentUpsampler drops, for both LTX workers' stage-2 refine.
# Placed after the slow layers so only the fast user-setup layers rerun;
# the recursive chown below covers the pack.
COPY worker/ltx_mask_utils/ /opt/comfyui/custom_nodes/ltx_mask_utils/
RUN grep -q 'LTXPrefixFreeze' /opt/comfyui/custom_nodes/ltx_mask_utils/prefix_freeze.py

# llama-server sidecar (Qwen director, DESIGN §140 llama entry): same pinned
# SOURCE build as worker/Dockerfile.video (this ltx image serves the default
# `generate` path — video=ltx25 + director=llama — so it needs the binary too;
# its absence was the `cannot spawn llama-server ... Errno 2` generate failure).
# Pinned tag b11146 (2026-09-23) with a hard sha256 gate on the source tarball
# (37,561,762 bytes). `python3.11 -m pip` for the cmake wheel (no bare `pip`
# exists in this image); CUDA comes from the image toolkit (nvcc present).
# Only the `llama-server` target builds, for sm_75 (RTX 2060) + sm_86
# (RTX 4060 Ti) only. One layer, cached on success; sources removed after
# install so only /opt/llama.cpp survives. Re-pin procedure: update tag +
# source sha below, rebuild (mirror any change into Dockerfile.video).
RUN set -eux; \
    python3.11 -m pip install --no-cache-dir "cmake==4.1.3" && \
    python3 <<'PYEOF'
import hashlib
import os
import tarfile
import urllib.request
url = "https://github.com/ggml-org/llama.cpp/archive/refs/tags/b11146.tar.gz"
expected_sha256 = "25eb89e300a0600bfdfadaac2acc7ec3a93cd23b992b7eff3c0eeae7987e4474"
archive_path = "/tmp/llama-source.tar.gz"
urllib.request.urlretrieve(url, archive_path)
digest = hashlib.sha256()
with open(archive_path, "rb") as archive:
    for chunk in iter(lambda: archive.read(1048576), b""):
        digest.update(chunk)
actual_sha256 = digest.hexdigest()
if actual_sha256 != expected_sha256:
    raise SystemExit(f"llama.cpp source sha mismatch: {actual_sha256}")
def _is_safe_member(member):
    name = member.name
    if not name or name.startswith("/") or os.path.isabs(name):
        return False
    if ".." in name.split("/"):
        return False
    if member.issym() or member.islnk():
        return False
    if member.isdev() or member.ischr() or member.isblk() or member.isfifo():
        return False
    return True
with tarfile.open(archive_path) as archive:
    members = archive.getmembers()
    unsafe = [m.name for m in members if not _is_safe_member(m)]
    if unsafe:
        raise SystemExit(f"llama.cpp source tarball has unsafe members: {unsafe[:10]}")
    archive.extractall("/tmp/llama-source")
PYEOF
# A heredoc terminator cannot carry a `\` continuation, so the RUN above
# ends at PYEOF — configure/build/install/smoke are their own layer.
# NOTE: no `cmake --install` here on purpose — installing the
# `llama-server` target alone leaves the `tests` install rules with
# unbuilt files and the install step fails. The binary + its shared libs
# are copied out directly instead; the loader finds the libs via
# LD_LIBRARY_PATH below (no RUNPATH is baked in by a plain copy).
ENV LD_LIBRARY_PATH=/opt/llama.cpp/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
RUN set -eux; \
    cmake -S /tmp/llama-source/llama.cpp-b11146 -B /tmp/llama-build \
        -DGGML_CUDA=ON -DLLAMA_CURL=OFF -DCMAKE_BUILD_TYPE=Release \
        "-DCMAKE_CUDA_ARCHITECTURES=75;86" \
        "-DCMAKE_INSTALL_RPATH=$$ORIGIN/../lib" && \
    cmake --build /tmp/llama-build --target llama-server -j"$(nproc)" && \
    mkdir -p /opt/llama.cpp/bin /opt/llama.cpp/lib && \
    cp /tmp/llama-build/bin/llama-server /opt/llama.cpp/bin/ && \
    find /tmp/llama-build -name 'lib*.so*' -exec cp -P {} /opt/llama.cpp/lib/ \; && \
    rm -rf /tmp/llama-source /tmp/llama-build /tmp/llama-source.tar.gz && \
    test -x /opt/llama.cpp/bin/llama-server && \
    ln -sfn /opt/llama.cpp/bin/llama-server /usr/local/bin/llama-server
# NOTE: no `llama-server --version` smoke gate here on purpose — the
# build container has no GPU, so libcuda.so.1 (driver-provided) is
# absent and the CUDA binary cannot start until runtime with --gpus.
# The live GPU run is the real smoke test.

# ACE-Step music venv (DESIGN §140 audio continuity): ltx25/ltx23 take
# continuous music from the ACE planner, so this image needs the ACE stack
# — but ACE-Step-1.5 pins transformers>=4.51,<4.58 while the validated LTX
# freeze above runs transformers 5.17. Isolated venv (same pattern as the
# director venv): torch trio matching the main env (cu130) + the video
# image's ACE leaf deps + transformers pin-back; the supervisor spawns the
# audio worker with this interpreter via VOYAGE_ACESTEP_PYTHON below.
# Verified-fetch clone (same contract as above). Placed after the slow
# layers so only the fast user-setup layers rerun; the recursive chown
# below covers the venv + clone.
RUN git clone --depth 1 https://github.com/ace-step/ACE-Step-1.5.git /opt/ACE-Step-1.5 \
    && git -C /opt/ACE-Step-1.5 fetch --depth 1 origin ca1e85fe9430179831e6bc6be790c332190a3866 \
    && git -C /opt/ACE-Step-1.5 checkout ca1e85fe9430179831e6bc6be790c332190a3866 \
    && git -C /opt/ACE-Step-1.5 rev-parse --verify HEAD \
    && python3.11 -m venv /opt/venvs/acestep \
    && /opt/venvs/acestep/bin/pip install "pip==25.0.1" \
    && /opt/venvs/acestep/bin/pip install torch==2.14.0 torchvision==0.29.0 torchaudio==2.11.0 \
        --index-url https://download.pytorch.org/whl/cu130 \
    && /opt/venvs/acestep/bin/pip install soundfile==0.14.0 loguru==0.7.3 numba==0.67.0 vector-quantize-pytorch==1.31.6 "sentence-transformers==6.1.0" "einops==0.8.2" "safetensors==0.8.0" "pydantic==2.10.6" "diffusers==0.31.0" \
    && /opt/venvs/acestep/bin/pip install transformers==4.57.6 \
    && ACE_SITE="$(/opt/venvs/acestep/bin/python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')" \
    && echo "/opt/ACE-Step-1.5" > "${ACE_SITE}/ace-step-1.5.pth" \
    && test -d /opt/ACE-Step-1.5/.git \
    && test -f "${ACE_SITE}/ace-step-1.5.pth" \
    && test -x /opt/venvs/acestep/bin/python

# MMAudio SFX venv (DESIGN §140 SFX continuity): ltx finalize dubs SFX
# through the MMAudio worker, so this image needs that stack too — but the
# main env is the validated LTX freeze, so it stays isolated (same venv
# pattern as above): torch trio matching the main env (cu130) + the video
# image's MMAudio inference closure (no-deps editable clone + open_clip
# tower + audio/math leaf deps); finalize spawns the SFX worker with this
# interpreter via VOYAGE_SFX_PYTHON below. Verified-fetch clone (same
# contract as above). Placed after the slow layers so only the fast
# user-setup layers rerun; the recursive chown below covers venv + clone.
RUN git clone --depth 1 https://github.com/hkchengrex/MMAudio.git /opt/mmaudio \
    && git -C /opt/mmaudio fetch --depth 1 origin 974010a026c731054592d8f777218bd9d85a6c24 \
    && git -C /opt/mmaudio checkout 974010a026c731054592d8f777218bd9d85a6c24 \
    && git -C /opt/mmaudio rev-parse --verify HEAD \
    && python3.11 -m venv /opt/venvs/sfx \
    && /opt/venvs/sfx/bin/pip install "pip==25.0.1" \
    && /opt/venvs/sfx/bin/pip install torch==2.14.0 torchvision==0.29.0 torchaudio==2.11.0 \
        --index-url https://download.pytorch.org/whl/cu130 \
    && /opt/venvs/sfx/bin/pip install --no-deps -e /opt/mmaudio \
    && /opt/venvs/sfx/bin/pip install "open_clip_torch==3.3.0" "librosa==0.11.0" "torchdiffeq==0.2.5" "accelerate==1.15.0" "colorlog==6.12.0" soundfile==0.14.0 "einops==0.8.2" "safetensors==0.8.0" "pydantic==2.10.6" "av==13.1.0" Pillow tqdm huggingface_hub numpy "omegaconf==2.3.1" "easydict==1.13" "ftfy==6.3.1" \
    && test -d /opt/mmaudio/.git \
    && test -x /opt/venvs/sfx/bin/python

# SonicMaster mastering venv (Track D, DESIGN §140): finalize-time
# mastering runs isolated (same venv pattern as above) because its pins
# (transformers 4.44 / diffusers 0.30) are irreconcilable with the
# validated LTX freeze (transformers 5.17). Interpreter is the image's
# existing python3.11 (torch 2.4.0+cu124 ships cp311 wheels but NO cp313
# wheel — verified live against the cu124 index — so the requested
# python3.13 is unbuildable with this torch pin; reusing 3.11 also avoids
# a new apt layer and keeps the slow layers above cached).
# huggingface_hub stays 0.36.2 (transformers 4.44 requires hub<1.0, so the
# 1.33.0 used elsewhere would break resolution); pydantic mirrors the
# other venvs (the future worker imports voyage over PYTHONPATH, which
# needs it). GPU-proof lesson (2026-10-07, proven live in this image):
# the SonicMaster repo needs two more import-time deps — model.py
# imports `datasets` at top level, and utils.py (imported by model.py)
# imports `torchaudio` + `pandas` at top level. datasets==3.6.0 is
# pinned (datasets 5.x drags huggingface_hub>=2, which breaks the
# diffusers 0.30 resolution); torchaudio==2.4.0 rides the cu124 index
# with torch; pandas arrives via datasets (frozen by the datasets
# pin). accelerate is deliberately absent — only the repo's
# training/batch scripts import it, never the model.py/utils.py
# inference path. yaml/tqdm/numpy arrive via transformers/torch (their
# hard requirements). The supervisor will spawn the mastering worker with this
# interpreter via VOYAGE_MASTERING_PYTHON below; unset (slim image,
# tests) falls back to the supervisor interpreter. Placed after the slow
# layers so only the fast user-setup layers rerun; the recursive chown
# below covers the venv (it already covers /opt/venvs).
RUN python3.11 -m venv /opt/venvs/mastering \
    && /opt/venvs/mastering/bin/pip install "pip==25.0.1" \
    && /opt/venvs/mastering/bin/pip install torch==2.4.0 torchaudio==2.4.0 \
        --index-url https://download.pytorch.org/whl/cu124 \
    && /opt/venvs/mastering/bin/pip install "transformers==4.44.0" "diffusers==0.30.0" \
        "soundfile==0.14.0" "safetensors==0.8.0" "huggingface_hub==0.36.2" "pydantic==2.10.6" \
        "datasets==3.6.0" \
    && test -x /opt/venvs/mastering/bin/python

# Run as the invoking host user (same contract as the video image): the
# supervisor and its worker subprocesses share bind mounts with the host,
# so a root container leaves root-owned renders behind. A real user
# carrying the host's UID/GID (build args, forwarded by
# scripts/build-ltx.sh from `id`; defaults 1000) keeps every written file
# host-owned. Rebuild after a host-uid change. Placed late so the slow
# torch/requirements/clone layers above stay cached. The usermod branch is
# load-bearing on ubuntu24.04-based images: the base already owns UID 1000
# under another name, so a uid-only getent check would skip useradd and the
# later `USER voyager` would fail to resolve.
ARG UID=1000
ARG GID=1000
RUN set -eux; \
  getent group "${GID}" >/dev/null || groupadd --gid "${GID}" voyager; \
  if ! getent passwd voyager >/dev/null; then \
    if getent passwd "${UID}" >/dev/null; then \
      usermod -l voyager -d /home/voyager -s /bin/bash "$(getent passwd "${UID}" | cut -d: -f1)"; \
    else \
      useradd --uid "${UID}" --gid "${GID}" --no-create-home --shell /bin/bash voyager; \
    fi; \
  fi; \
  mkdir -p /home/voyager && chown "${UID}:${GID}" /home/voyager && chmod 755 /home/voyager; \
  chown -R "${UID}:${GID}" /opt/comfyui /opt/ACE-Step-1.5 /opt/mmaudio /opt/venvs /opt/llama.cpp;
ENV HOME=/home/voyager
USER voyager

ENV PYTHONPATH=/opt/comfyui:/app \
    VOYAGE_DIRECTOR_PYTHON=/opt/venvs/director/bin/python \
    VOYAGE_ACESTEP_PYTHON=/opt/venvs/acestep/bin/python \
    VOYAGE_SFX_PYTHON=/opt/venvs/sfx/bin/python \
    VOYAGE_MASTERING_PYTHON=/opt/venvs/mastering/bin/python \
    VOYAGE_MODELS_DIR=/models \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# WORKDIR /app (same contract as the video image): keeps `-w /app` in
# run.sh as belt-and-braces; Phase-2 workers satisfy any CWD contract
# themselves with absolute voyage paths.
WORKDIR /app

# Build-time CLI gate (two-verb CLI): same probe the video image runs —
# verifies both verbs register inside THIS image's stack.
RUN voyage configure --help && voyage generate --help

CMD ["voyage", "--help"]
