# Base pinned by digest (issue 012): linux/amd64 manifest of
# nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04 resolved 2026-09-25
# (`docker buildx imagetools inspect --raw ...`). The tag alone drifts
# (CUDA/ffmpeg/libx264 encode bytes included); the digest freezes it.
# Bump procedure: resolve the new amd64 digest the same way, update FROM,
# re-freeze the pip pins below on a GPU box, note in docs/INSTALL.md.
FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04@sha256:2a015be069bda4de48d677b6e3f271a2794560c7d788a39a18ecf218cae0751d

# Phase 1 video worker env: CUDA 12.8 + Python 3.10 + torch 2.8.0/cu128 +
# TorchAO FP8 PTQ + voyage package. Eager mode
# (torch_compile off); flash-attn 2 is MANDATORY (upstream attention asserts
# it — no SDPA fallback). Layer order keeps slow builds cached across
# voyage-code edits (requirements + FA before COPY).
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    CUDA_HOME=/usr/local/cuda

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.10=3.10.12-1~22.04.18 python3.10-venv=3.10.12-1~22.04.18 \
        python3-pip=22.0.2+dfsg-1ubuntu0.7 git=1:2.34.1-1ubuntu1.17 \
        gcc=4:11.2.0-1ubuntu1 g++=4:11.2.0-1ubuntu1 \
        ffmpeg=7:4.4.2-0ubuntu0.22.04.1 \
    && rm -rf /var/lib/apt/lists/*
# Apt pins frozen 2026-09-30 from the live image (`docker run --rm
# voyage-video:latest dpkg-query -W ...`, image 63b8c37d — CPU-only probe,
# no GPU needed for a version query). Jammy snapshot, hence older than the
# slim trixie pins (ffmpeg 4.4.2 here vs 7.1.5 there). The digest-pinned
# FROM above keeps the snapshot reproducible; bump procedure: rebuild,
# re-query, update the pins, note in docs/INSTALL.md (same contract as
# the slim header `Dockerfile:5-7`).

# pip pinned exact (issue 012): 25.0.1 still supports python3.10.
RUN pip install "pip==25.0.1" \
    && pip install torch==2.8.0 torchvision==0.23.0 \
        --index-url https://download.pytorch.org/whl/cu128

# Python pins frozen 2026-09-30 from the live image
# (`docker run --rm voyage-video:latest pip freeze`, image 63b8c37d).
# Every direct row below is `==`-pinned to that freeze — floors (`>=`) are
# not pins. Re-freeze procedure on the next GPU build: rebuild, run
# `pip freeze`, update the pins below, note in docs/INSTALL.md. Transitive
# deps ride the direct rows (a full `--require-hashes` lockfile is the
# follow-up, same as issue 011 for the slim image).
RUN pip install torchao==0.13.0 "huggingface_hub[cli]==0.36.2" "pydantic==2.10.6"

# Verified-fetch clones (issue 055): `--depth 1` keeps the build context
# small; `fetch <commit>` + `checkout <commit>` + `rev-parse --verify`
# prove the pinned commit is exactly what got checked out (a bare
# `clone <url>` + `checkout` trusts the transport with no verification).
# License surface: the CausVid DMD checkpoint pulled at runtime is
# CC BY-NC-SA 4.0 (non-commercial, share-alike — see model_registry.py
# CAUSVID_LICENSE + docs/MODELS.md); the LTXV/ACE-Step stacks
# carry their own upstream licenses — check before redistributing images.
#
# (A removed video backend's clone + requirements row lived here until
# issue 079 deleted the backend with it.)

# Python headers for JIT builds at runtime (triton compiles its CUDA utils
# on first use; gcc alone is not enough). Placed late so the heavy torch /
# requirements layers above stay cached.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3.10-dev=3.10.12-1~22.04.18 \
    && rm -rf /var/lib/apt/lists/*

# Mandatory attention backend (see header note). Built for the host GPU
# family at image build time; sm89 (Ada) is covered by the default arch list.
# NOTE (issue 067): frozen exact at the 2026-09-30 freeze — it must still be
# built against the host GPU family at image build time, so the pin can only
# be re-frozen on a GPU box (`pip freeze` after a good build, then pin exact).
RUN pip install flash-attn==2.8.3.post1 --no-build-isolation

# ACE-Step 1.5 music stack (Phase 4, DESIGN §140): same pinned clone the
# zoomy GPU image carries, plus the audio-only pip deps the video image
# lacks (probe-verified 2026-09-22 under torch 2.8.0+cu128: 30s take in
# 4.3s, peak 12.84GB — identical to torch 2.10). torchaudio must match
# torch 2.8.0 from the cu128 index; the rest are stable leaf deps.
# Verified-fetch clone (issue 055): see the clone note above.
RUN git clone --depth 1 https://github.com/ace-step/ACE-Step-1.5.git /opt/ACE-Step-1.5 \
    && git -C /opt/ACE-Step-1.5 fetch --depth 1 origin ca1e85fe9430179831e6bc6be790c332190a3866 \
    && git -C /opt/ACE-Step-1.5 checkout ca1e85fe9430179831e6bc6be790c332190a3866 \
    && git -C /opt/ACE-Step-1.5 rev-parse --verify HEAD \
    && pip install soundfile==0.14.0 loguru==0.7.3 numba==0.67.0 vector-quantize-pytorch==1.31.6 "sentence-transformers==6.1.0" \
    && pip install torchaudio==2.8.0 \
        --index-url https://download.pytorch.org/whl/cu128

# sentence-transformers pulls transformers 5.x, which breaks the pinned
# transformers-4.x stack — pin back. Phase 3 E2E used
# 4.57.6; MiniLM embedding is verified against it below.
RUN pip install transformers==4.57.6

# MMAudio SFX stack (SFX slice 2, three-caption doctrine): upstream
# hkchengrex/MMAudio at the pinned commit (CC-BY-NC-4.0 non-commercial
# weights — same class as the CausVid DMD checkpoint; check before
# redistributing images). Native .pth weights load with plain torch
# (no comfy-loader machinery); 44 kHz variants only. `--no-deps`: the
# upstream project pulls training/demo weight (gradio, torchcodec,
# tensorboard, hydra, gitpython, tensordict — never `pip install -r`
# a second requirements file here, same rule as the CausVid note);
# only the inference closure lands explicitly (open_clip CLIP tower,
# librosa/torchdiffeq/accelerate). Its requirements land BEFORE the
# transformers pin below is re-asserted, so the 4.57.6 pin
# always wins.
# Verified-fetch clone (issue 055): see the clone note above.
RUN git clone --depth 1 https://github.com/hkchengrex/MMAudio.git /opt/mmaudio \
    && git -C /opt/mmaudio fetch --depth 1 origin 974010a026c731054592d8f777218bd9d85a6c24 \
    && git -C /opt/mmaudio checkout 974010a026c731054592d8f777218bd9d85a6c24 \
    && git -C /opt/mmaudio rev-parse --verify HEAD \
    && pip install --no-deps -e /opt/mmaudio \
    && pip install "open_clip_torch==3.3.0" "librosa==0.11.0" "torchdiffeq==0.2.5" "accelerate==1.15.0" "colorlog==6.12.0"

# Re-assert the transformers floor after the SFX requirements (same pin,
# same reason as above — idempotent when already satisfied).
RUN pip install transformers==4.57.6

# LTXV 2B-distilled alternative backend (Phase 7, DESIGN §140): native
# ltx-video library at the probe-verified pin (NOT diffusers — the image
# has no LTX pipelines). --no-deps: ltx-video demands
# transformers>=4.47.2,<4.52.0, which would downgrade the 4.57.6 pin
# above; the T5 code path used here is stable across 4.x (probe-verified).
# The [inference] extra (imageio[ffmpeg], av, torchvision) plus
# sentencepiece/einops/timm land explicitly below.
# NOTE (issue 055): the pip-git fetch below is the same unverified-fetch
# class as the clones (commit-pinned via @rev, but no --depth/hash check
# is expressible in a PEP 508 URL) — accepted: the rev is pinned and the
# tree is small; vendor a tarball with sha256 if this ever moves to prod.
RUN pip install --no-deps "ltx-video[inference] @ git+https://github.com/Lightricks/LTX-Video@4b2d053057623ddd4d0a1d3e9cd28890e9ef487f" \
    && pip install "imageio[ffmpeg]==2.38.0" "imageio-ffmpeg==0.6.0" "av==13.1.0" "sentencepiece==0.2.2" "einops==0.8.2" "timm==1.0.30"

# CausVid DMD causal generator (Stream D prep, DESIGN §5.4): upstream code
# at the pinned commit; the worker will strict-load the DMD checkpoint's
# ['generator'] per the upstream long-video script. Leaf deps only — NEVER
# `pip install -r requirements.txt`: its numpy==1.24.4 / av==13.1.0 /
# gradio / moviepy pins would break the torch 2.8 + transformers 4.57.6 +
# LTXV stack above. The inference closure (causvid.models.wan.
# causal_inference → causal_model + wan_base modules) needs omegaconf
# (config), easydict (Wan configs), ftfy (T5 tokenizer) and diffusers
# (ConfigMixin/ModelMixin/schedulers in causal_model + wan_base model —
# confirmed by grepping the cloned sources at the pin). export_to_video
# (diffusers) and TextDataset (causvid.data) from the upstream demo script
# are NOT needed — Voyage has its own ffmpeg media I/O.
# Verified-fetch clone (issue 055): see the clone note above.
RUN git clone --depth 1 https://github.com/tianweiy/CausVid /opt/causvid \
    && git -C /opt/causvid fetch --depth 1 origin adb6a5ecd07666b4d0290042915c8406e6d5ce22 \
    && git -C /opt/causvid checkout adb6a5ecd07666b4d0290042915c8406e6d5ce22 \
    && git -C /opt/causvid rev-parse --verify HEAD \
    && pip install "omegaconf==2.3.1" "easydict==1.13" "ftfy==6.3.1" "diffusers==0.31.0"

# Finalize-stage augmentation weights (Track C): FILM interpolation
# (Comfy-Org fp16 .safetensors) + Real-ESRGAN anime 6B upscaler (xinntao
# v0.2.2.4 release asset) — pins in voyage/model_registry.py
# (FILM_*/REALESRGAN_*), fetched at runtime by `voyage models download`
# into /models. Both load torch-native (FILM state dict via safetensors,
# ESRGAN RRDBNet via torch.load weights_only) with vendored model code at
# the worker — no git clones, no basicsr/realesrgan packages (their pins
# would break the torch 2.8 / transformers 4.57.6 stack above). Leaf deps
# only: safetensors (.safetensors decode; floor matches transformers'
# requirement so the 4.57.6 pin above always wins) + Pillow (frame PNG
# I/O; torchvision already needs it, so this is explicit, never a bump).
RUN pip install "safetensors==0.8.0" "Pillow==12.3.0"

# Pre-created wan_models link (causvid-perms fix): the worker shim
# (`_enter_causvid_tree`) must satisfy upstream's
# CWD contract with a `wan_models/` symlink inside the repo clone, but the
# clones are root-owned while workers run as the host-mapped `voyager`
# user — a runtime mkdir/symlink there dies with Errno 13. Pre-creating
# the default-`/models` links here (as root) plus the skip-when-correct
# shim logic means the steady state performs zero writes under /opt.
# The link-farm modes below stay 755 (issue 075): owner-write covers the
# non-default-mount fallback, group/other stay read-execute.
RUN mkdir -p /opt/causvid/wan_models \
    && ln -sfn /models/Wan2.1-T2V-1.3B /opt/causvid/wan_models/Wan2.1-T2V-1.3B

# Console progress (rich) lands first (issue 054):
# pure-leaf install before any COPY, so voyage-code edits never reinstall
# it. Version matches the slim lockfile. (textual launcher TUI removed
# with the two-verb CLI — bare `voyage` prints help.)
RUN pip install "rich==15.0.0"

# Voyage supervisor package (pure-python here; torch lives only behind the
# worker module import). --no-deps: pydantic already pinned above, so the
# editable install adds only the voyage package itself.
COPY pyproject.toml README.md /app/
COPY voyage/ /app/voyage/
RUN pip install --no-deps -e /app

# Director decider venv (GPU director): the main env pins transformers
# 4.57.6, but the Qwen decider needs transformers 5.17.0
# (native AWQ-via-gptqmodel path) — irreconcilable in one site-packages,
# so the director worker runs in this isolated venv on the second GPU.
# Pins are probe-verified 2026-09-30 on sm_75 (RTX 2060): torch 2.11.0+cu128
# (cp310 wheel on the cu128 index) + GPTQModel 7.5.0 (transformers 5.17
# loads AWQ through it; autoawq is deprecated and must NOT be installed).
# The supervisor spawns the director with this interpreter via
# VOYAGE_DIRECTOR_PYTHON below; unset (slim image, tests) falls back to
# sys.executable. voyage itself resolves via the /app PYTHONPATH entry.
RUN python3.10 -m venv /opt/venvs/director \
    && /opt/venvs/director/bin/pip install "pip==25.0.1" \
    && /opt/venvs/director/bin/pip install torch==2.11.0 \
        --index-url https://download.pytorch.org/whl/cu128 \
    && /opt/venvs/director/bin/pip install "GPTQModel==7.5.0" "sentence-transformers==6.1.0" \
        "safetensors==0.8.0" "huggingface_hub[cli]==1.33.0" "pydantic==2.10.6" \
    && /opt/venvs/director/bin/pip install transformers==5.17.0

# llama-server sidecar (Qwen director, DESIGN §140 llama entry): built
# from pinned SOURCE, not the prebuilt binaries. The b11146 release
# binaries link GLIBC_2.38 (Ubuntu 24.04 build hosts) and die at startup
# on this image's glibc 2.35 (proven live: prebuilt `llama-server
# --version` failed with `GLIBC_2.38 not found`); a source build links
# the local libc instead. Pinned tag b11146 (2026-09-23) with a hard
# sha256 gate on the source tarball (37,561,762 bytes). cmake comes from
# a pinned pip wheel (none in the image, apt pins frozen); CUDA comes
# from the image toolkit (nvcc present). Only the `llama-server` target
# builds, for sm_75 (RTX 2060) + sm_86 (RTX 4060 Ti) only — full-arch
# fatbins would triple the build; retune CUDA_ARCHITECTURES if the
# fleet changes. One layer, cached on success; sources removed after
# install so only /opt/llama.cpp survives (the chown below is unchanged).
# Re-pin procedure: update tag + source sha below, rebuild.
RUN set -eux; \
    python3 -m pip install --no-cache-dir "cmake==4.1.3" && \
    python3 <<'PYEOF'
import hashlib
import tarfile
import urllib.request
url = "https://github.com/ggml-org/llama.cpp/archive/refs/tags/b11146.tar.gz"
expected_sha256 = "25eb89e300a0600bfdfadaac2acc7ec3a93cd23b992b7eff3c0eeae7987e4474"
archive_path = "/tmp/llama-source.tar.gz"
urllib.request.urlretrieve(url, archive_path)
digest = hashlib.sha256()
with open(archive_path, "rb") as archive:
    for chunk in iter(lambda: archive.read(1048576), b""):
        digest.update(chunk)
actual_sha256 = digest.hexdigest()
if actual_sha256 != expected_sha256:
    raise SystemExit(f"llama.cpp source sha mismatch: {actual_sha256}")
with tarfile.open(archive_path) as archive:
    archive.extractall("/tmp/llama-source")
PYEOF
# A heredoc terminator cannot carry a `\` continuation, so the RUN above
# ends at PYEOF — configure/build/install/smoke are their own layer.
# NOTE: no `cmake --install` here on purpose — installing the
# `llama-server` target alone leaves the `tests` install rules with
# unbuilt files and the install step fails. The binary + its shared libs
# are copied out directly instead; the loader finds the libs via
# LD_LIBRARY_PATH below (no RUNPATH is baked in by a plain copy).
ENV LD_LIBRARY_PATH=/opt/llama.cpp/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
RUN set -eux; \
    cmake -S /tmp/llama-source/llama.cpp-b11146 -B /tmp/llama-build \
        -DGGML_CUDA=ON -DLLAMA_CURL=OFF -DCMAKE_BUILD_TYPE=Release \
        "-DCMAKE_CUDA_ARCHITECTURES=75;86" \
        "-DCMAKE_INSTALL_RPATH=$$ORIGIN/../lib" && \
    cmake --build /tmp/llama-build --target llama-server -j"$(nproc)" && \
    mkdir -p /opt/llama.cpp/bin /opt/llama.cpp/lib && \
    cp /tmp/llama-build/bin/llama-server /opt/llama.cpp/bin/ && \
    find /tmp/llama-build -name 'lib*.so*' -exec cp -P {} /opt/llama.cpp/lib/ \; && \
    rm -rf /tmp/llama-source /tmp/llama-build /tmp/llama-source.tar.gz && \
    test -x /opt/llama.cpp/bin/llama-server && \
    ln -sfn /opt/llama.cpp/bin/llama-server /usr/local/bin/llama-server
# NOTE: no `llama-server --version` smoke gate here on purpose — the
# build container has no GPU, so libcuda.so.1 (driver-provided) is
# absent and the CUDA binary cannot start until runtime with --gpus.
# The live GPU A/B on cuda:1 is the real smoke test.

# Run as the invoking host user (issue 053 follow-up): the supervisor and
# its worker subprocesses share bind mounts with the host ($PWD:/app,
# /tmp:/tmp, $models:/models), so a root container leaves root-owned
# renders behind. A real user carrying the host's UID/GID (build args,
# forwarded by scripts/build-video.sh from `id`; defaults 1000) keeps
# every written file host-owned. Rebuild after a host-uid change. Placed
# late so the slow torch/flash-attn layers above stay cached.
ARG UID=1000
ARG GID=1000
RUN set -eux; \
  getent group "${GID}" >/dev/null || groupadd --gid "${GID}" voyager; \
  getent passwd "${UID}" >/dev/null || useradd --uid "${UID}" --gid "${GID}" --no-create-home --shell /bin/bash voyager; \
  mkdir -p /home/voyager && chown "${UID}:${GID}" /home/voyager && chmod 755 /home/voyager; \
   chown -R "${UID}:${GID}" /opt/causvid /opt/ACE-Step-1.5 /opt/mmaudio /opt/venvs /opt/llama.cpp; \
  chmod 755 /opt/causvid/wan_models
# Least-privilege link farm (issue 075): the shim target above is
# owner-writable (the chown line) so the pinned `--user` worker can still
# re-point non-default mounts, but group/other get read-execute only —
# the old `chmod 777` let any in-container process plant importable code
# on PYTHONPATH (/opt/causvid). Cross-UID runs against a stale image
# (no rebuild after a host-uid change) now fail loud with Errno 13 on the
# shim write instead of silently succeeding world-writable — rebuild.
ENV HOME=/home/voyager
USER voyager

ENV PYTHONPATH=/opt/ACE-Step-1.5:/opt/causvid:/opt/mmaudio:/app \
    VOYAGE_DIRECTOR_PYTHON=/opt/venvs/director/bin/python \
    VOYAGE_MODELS_DIR=/models \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# WORKDIR /app (issue 053): an upstream-repo CWD swallowed relative
# outputs on bare `docker run` (only run.sh's `-w /app` saved it). Safe:
# the workers satisfy upstream's CWD contract themselves at runtime
# (`_enter_causvid_tree` chdirs into the repo tree with absolute voyage
# paths, so the chdir is side-effect free).
# Keep `-w /app` in run.sh as belt-and-braces.
WORKDIR /app

# Build-time CLI gate (two-verb CLI): same probe the slim image runs —
# verifies both verbs register inside THIS image's stack.
RUN voyage configure --help && voyage generate --help

CMD ["voyage", "--help"]
